{
  "name": "vox-ambient-assistant",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern desktop/VoxDesktop/dist",
    "test:privacy": "node --experimental-strip-types scripts/test-privacy.mjs",
    "test:memory-summary": "node --experimental-strip-types scripts/test-memory-summary.mjs",
    "test:reply-length": "node --experimental-strip-types scripts/test-reply-length.mjs",
    "test:response-language": "node --experimental-strip-types scripts/test-response-language.mjs",
    "test:response-posture": "node --experimental-strip-types scripts/test-response-posture.mjs",
    "test:social-policy": "node --experimental-strip-types scripts/test-social-policy.mjs",
    "test:visual-theme": "node --experimental-strip-types scripts/test-visual-theme.mjs",
    "test:vision": "node --experimental-strip-types scripts/test-vision.mjs",
    "test:local-codex-route": "node --experimental-strip-types scripts/test-local-codex-route.mjs",
    "test:desktop-action-route": "node --experimental-strip-types scripts/test-desktop-action-route.mjs",
    "test:desktop-control-route": "node --experimental-strip-types scripts/test-desktop-control-route.mjs",
    "test:local-capability-policy": "node --experimental-strip-types scripts/test-local-capability-policy.mjs",
    "test:smart-home-route": "node --experimental-strip-types scripts/test-smart-home-route.mjs",
    "test:remote-control": "node --experimental-strip-types scripts/test-remote-control.mjs",
    "test:conversation-context": "node --experimental-strip-types scripts/test-conversation-context.mjs",
    "db:generate": "drizzle-kit generate",
    "deploy:prepare": "node scripts/prepare-cloudflare-deploy.mjs",
    "deploy:migrate": "wrangler d1 migrations apply DB --remote --config dist/server/wrangler.deploy.json",
    "deploy:worker": "wrangler deploy --config dist/server/wrangler.deploy.json",
    "deploy:cloudflare": "npm run build && npm run deploy:prepare && npm run deploy:migrate && npm run deploy:worker"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
